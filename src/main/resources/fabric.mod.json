{
	"schemaVersion": 1,
	"id": "vanillax",
	"version": "${version}",
	"name": "VanillaX",
	"description": "A simple client-side mod designed to enhance your Vanilla Minecraft experience.",
	"authors": [
		"TacoVN"
	],
	"license": "All Rights Reserved",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.vanillax.VanillaXClient"
		]
	},
	"mixins": [
		{
			"config": "vanillax.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25"
	}
}
